<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- 风险指示条 -->
        <View
            android:id="@+id/v_risk_indicator"
            android:layout_width="4dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            android:background="@color/success" />

        <!-- ★ 缩略图 -->
        <ImageView
            android:id="@+id/iv_history_thumb"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:scaleType="centerCrop"
            android:background="@drawable/card_bg_light"
            android:visibility="gone"
            android:contentDescription="检测缩略图" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_history_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="视频检测"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_source_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/banner_tag_bg"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:text="云端"
                    android:textColor="@color/text_white"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_history_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="文件名.mp4 · 2026-07-31 20:30"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_history_verdict"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="风险评分: 23% · 真实"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_delete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:alpha="0.3"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_warning"
            android:contentDescription="删除" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
