<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_detail_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="视频真伪检测"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_detail_source"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/banner_tag_bg"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="AI模型"
                android:textColor="@color/text_white"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- ★ 检测图片 - 自适应完整显示 + 点击全屏 -->
        <TextView
            android:id="@+id/tv_image_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🔍 检测图片（点击放大）"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_detail_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:minHeight="180dp"
            android:background="@drawable/card_bg_light"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="检测图片（点击查看大图）" />

        <!-- 音频播放按钮（仅音频记录显示） -->
        <Button
            android:id="@+id/btn_play_audio"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/accent"
            android:text="▶ 播放检测音频"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 风险判定区 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/bg_primary"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_detail_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@color/warning"
                    android:textSize="56sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_detail_verdict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="可疑"
                    android:textColor="@color/warning"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progress_detail_risk"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="14dp"
                    android:max="100"
                    android:progress="45" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 详细信息 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="检测详情"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg_light"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="6dp">
                <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                    android:text="检测时间" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <TextView android:id="@+id/tv_detail_time" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="2026-08-02 12:30" android:textColor="@color/text_primary" android:textSize="13sp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/bg_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="6dp">
                <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                    android:text="检测引擎" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <TextView android:id="@+id/tv_detail_engine" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="EfficientNet-B0" android:textColor="@color/text_primary" android:textSize="13sp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/bg_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="6dp">
                <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                    android:text="文件名称" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <TextView android:id="@+id/tv_detail_file" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="capture_12345.jpg" android:textColor="@color/text_primary" android:textSize="13sp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/bg_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="6dp">
                <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                    android:text="风险评分" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <TextView android:id="@+id/tv_detail_score" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="45%" android:textColor="@color/text_primary" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 处理建议 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="处理建议"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_detail_suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg_light"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:text="建议内容..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
