<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_ai"
    android:orientation="vertical"
    tools:context=".ui.call.CallDetectFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="通话检测"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="实时识别对方声音是否为 AI 合成"
            android:textColor="#B0C4DE"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 中央识别区（听歌识曲风格） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- 圆形录音按钮 + 脉冲波纹 -->
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center">

            <View
                android:id="@+id/ripple_ring"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_button" />

            <TextView
                android:id="@+id/btn_call_toggle"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="开始检测"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 说话波形（录音时跳动） -->
        <com.example.deepfake_fight.ui.widget.WaveView
            android:id="@+id/wave_call"
            android:layout_width="160dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp" />

        <!-- 风险分数 -->
        <TextView
            android:id="@+id/tv_call_risk_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="--"
            android:textColor="@color/text_white"
            android:textSize="52sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_call_verdict"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="点击按钮开始实时检测"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_call_segments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 底部提示 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="20dp"
        android:gravity="center"
        android:text="接听可疑电话时打开免提，点击按钮开始检测"
        android:textColor="@color/text_hint"
        android:textSize="12sp" />
</LinearLayout>
