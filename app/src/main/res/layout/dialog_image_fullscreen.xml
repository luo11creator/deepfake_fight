<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- 注意：必须用普通 ImageView，Material主题会把 AppCompatImageView 转成 MaterialTextView 导致崩溃 -->
    <ImageView
        android:id="@+id/iv_fullscreen_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="检测结果大图" />

    <!-- 关闭按钮 -->
    <TextView
        android:id="@+id/btn_close_fullscreen"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/camera_btn_close"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="✕"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

</FrameLayout>
